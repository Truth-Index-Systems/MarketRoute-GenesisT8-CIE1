{
  "version": "MRV2-DB-BOUNDARY-1.1.0",
  "build": 3,
  "principles": {
    "evidenceIsNotAuthority": true,
    "reasoningIsNotAuthority": true,
    "workflowIsNotAuthority": true,
    "authorityIsAppendOnly": true,
    "authorityIsTimeBound": true,
