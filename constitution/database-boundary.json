    "source_records",
    "source_acquisitions",
    "evidence_items",
    "claims",
    "claim_supersessions",
    "claim_evidence_links"
  ],
  "nonAuthoritativeReasoningTables": [
    "reasoning_runs",
    "reasoning_artifacts"
  ],
  "lockedAuthorityTables": [
    "authority_writer_registry",
    "authority_records",
    "authority_events"
  ],
  "workflowTables": [
    "opportunities",
    "opportunity_human_reviews"
  ],
  "appendOnlyTables": [
    "source_acquisitions",
    "evidence_items",
    "claims",
    "claim_supersessions",
    "claim_evidence_links",
    "reasoning_artifacts",
    "authority_records",
    "authority_events",
    "opportunity_human_reviews",
