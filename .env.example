# === REQUIRED: Vercel Production ===
SUPABASE_URL=https://YOUR_V2_PROJECT_REF.supabase.co

# Preferred current Supabase keys (Settings -> API Keys)
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy fallback supported by this release. Use these instead of the two keys above only if needed.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# === REQUIRED: Founder operations dashboard (/dashboard) ===
FOUNDER_DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
FOUNDER_DASHBOARD_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# === PRODUCTION RESEARCH GOVERNANCE ===
# Defaults below match the production activation code if omitted.
MARKETROUTE_DEFAULT_DAILY_RESEARCH_BUDGET_USD=100
MARKETROUTE_DEFAULT_MAX_JOB_COST_USD=0.50
MARKETROUTE_DEFAULT_RESEARCH_CONCURRENCY=2
MARKETROUTE_DEFAULT_WORK_UNITS_PER_PLAN=4
MARKETROUTE_DEFAULT_REFRESH_HORIZON_HOURS=2
MARKETROUTE_BOOTSTRAP_TARGET_COUNT=12
MARKETROUTE_CRON_BOOTSTRAP_BATCH=2
MARKETROUTE_CRON_RESEARCH_PLANNING_TARGETS=50
MARKETROUTE_CRON_RESEARCH_WORK_EXECUTIONS=8

# === OPTIONAL EMAIL DELIVERY ===
# Keep false until your sending domain is verified in Resend and a live send test is complete.
MARKETROUTE_DELIVERY_ENABLED=false
RESEND_API_KEY=re_...
MARKETROUTE_EMAIL_FROM=MarketRoute <outreach@YOUR-VERIFIED-DOMAIN>
MARKETROUTE_EMAIL_REPLY_TO=
MARKETROUTE_CRON_DELIVERY_BATCH=10

# === OPENAI COST ACCOUNTING / BEHAVIOUR ===
# Defaults match GPT-5.6 Luna pricing and production configuration at release time.
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.02
OPENAI_OUTPUT_USD_PER_MILLION=1.20
OPENAI_WEB_SEARCH_USD_PER_CALL=0.01
OPENAI_REASONING_EFFORT=low
OPENAI_WEB_SEARCH_CONTEXT=medium

# No NEXT_PUBLIC_* Supabase key is required: authentication remains server-mediated.
# Build 17 migration/certification variables are offline-only and should NOT be added to Vercel.
